{
  "name": "portfolio",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check && npm run lint && npm run format:check && npm test && npm run test:integration && npm audit",
    "prebuild": "node scripts/normalizeVercelConfig.mjs",
    "build": "npm run check && astro build",
    "preview": "vite preview --outDir dist/client",
    "astro": "astro",
    "test": "node --test tests/*.test.mjs",
    "test:integration": "node --test tests/api.integration.mjs",
    "test:browser": "node --test tests/client.production.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.6",
    "@astrojs/vercel": "^11.0.14",
    "@fontsource/didact-gothic": "^5.2.7",
    "@tailwindcss/vite": "^4.2.4",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "astro": "^7.3.8",
    "disable-devtool": "^0.3.9",
    "lucide-react": "^1.14.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "swiper": "^12.1.4",
    "tailwindcss": "^4.2.4",
    "three": "^0.184.0"
  },
  "overrides": {
    "path-to-regexp": "6.3.0",
    "yaml": "2.8.3",
    "brace-expansion": "^5.0.12",
    "devalue": "^5.8.1",
    "fast-uri": "^3.1.2",
    "glob": "^14.0.3",
    "minimatch": "^11.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/three": "^0.184.0",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-sonarjs": "^4.0.3",
    "globals": "^17.5.0",
    "javascript-obfuscator": "5.9.0",
    "playwright": "1.64.0",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2"
  }
}
