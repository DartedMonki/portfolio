---
import { Globe } from 'lucide-react';
import { getPortfolioProjects } from '../data/projects';
import type { Locale } from '../data/locales';
import BlackBorderButtonLink from './BlackBorderButtonLink';
import ProjectCarousel from './ProjectCarousel';
import StoreBadgeLink from './StoreBadgeLink.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const projects = getPortfolioProjects(locale);
---

{
  projects.map(({ coverSize, description, images, isDark, links, technologies, title }) => {
    const titleId = `project-${title
      .toLowerCase()
      .replaceAll(/[^a-z0-9]+/g, '-')
      .replaceAll(/^-|-$/g, '')}`;
    const [width, height] = coverSize;
    const desktopWidth = width === height ? 480 : Math.round(640 * Math.min(1, width / height));
    const hasStoreBadge = links?.some(({ type }) => type === 'app-store' || type === 'google-play');

    return (
      <section
        class:list={[
          'flex min-h-screen max-w-[100vw] flex-col justify-center overflow-x-hidden',
          isDark ? 'bg-black' : 'bg-white',
        ]}
        aria-labelledby={titleId}
      >
        <header class="my-6 flex flex-col items-center px-4 text-center">
          <h2
            id={titleId}
            class:list={['m-0 text-3xl font-bold', isDark ? 'text-white' : 'text-black']}
          >
            {title}
          </h2>
          <p
            class:list={[
              'mt-3 mb-0 max-w-4xl text-sm leading-7',
              isDark ? 'text-white/75' : 'text-neutral-700',
            ]}
          >
            {description}
          </p>
          <p
            class:list={[
              'mt-3 mb-0 text-sm font-bold',
              isDark ? 'text-white/70' : 'text-neutral-600',
            ]}
          >
            {technologies.join(' • ')}
          </p>
        </header>
        <div
          class="mx-auto w-[min(256px,100%)] md:w-(--gallery-width)"
          style={{ '--gallery-width': `${desktopWidth}px` }}
        >
          <ProjectCarousel
            client:visible={{ rootMargin: '240px' }}
            title={title}
            images={images}
            coverSize={coverSize}
            desktopWidth={desktopWidth}
          />
        </div>
        <div class="my-6 flex flex-wrap items-center justify-center gap-2.5 px-2.5 min-[360px]:gap-3 min-[360px]:px-4">
          {links?.map((link) => {
            if (link.type === 'app-store' || link.type === 'google-play') {
              return (
                <StoreBadgeLink
                  store={link.type}
                  href={link.href}
                  locale={locale}
                  projectTitle={title}
                />
              );
            }

            return (
              <div class:list={['flex justify-center', hasStoreBadge && 'w-full']}>
                <BlackBorderButtonLink
                  href={link.href}
                  invert={isDark}
                  aria-label={`Visit ${title} ${link.text}`}
                >
                  {link.type === 'github' && (
                    <svg
                      aria-hidden="true"
                      class="mr-2 h-5 w-5"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                    >
                      <path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.69c-2.78.6-3.37-1.34-3.37-1.34-.46-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.89 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.99 1.03-2.69-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.03A9.58 9.58 0 0 1 12 6.82c.85 0 1.71.11 2.51.34 1.91-1.3 2.75-1.03 2.75-1.03.55 1.37.2 2.39.1 2.64.64.7 1.03 1.6 1.03 2.69 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 12 2Z" />
                    </svg>
                  )}
                  {link.type === 'website' && <Globe aria-hidden="true" className="mr-2 h-5 w-5" />}
                  {link.text}
                </BlackBorderButtonLink>
              </div>
            );
          })}
        </div>
      </section>
    );
  })
}
