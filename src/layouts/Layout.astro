---
import '../styles/global.css';

import {
  AVATAR_URL,
  GITHUB_URL,
  LINKEDIN_URL,
  PERSON_ALIASES,
  PERSON_EXPERTISE,
  PERSON_NAME,
  PERSON_ROLE,
  SEO_DEFAULTS,
  SITE_URL,
} from '../data/constants';

interface Props {
  lang?: 'en' | 'id';
  path?: string;
  title?: string;
  description?: string;
}

const {
  lang = 'en',
  path = Astro.url.pathname,
  title = SEO_DEFAULTS.title,
  description = SEO_DEFAULTS.description,
} = Astro.props;
const canonicalPath = path === '/id' ? '/id/' : path;
const canonicalUrl = new URL(canonicalPath, SITE_URL).toString();
const alternateUrls = [
  { href: new URL('/', SITE_URL).toString(), hreflang: 'en' },
  { href: new URL('/id/', SITE_URL).toString(), hreflang: 'id' },
  { href: new URL('/', SITE_URL).toString(), hreflang: 'x-default' },
];
const ogLocale = lang === 'id' ? 'id_ID' : 'en_US';
const ogAlternateLocale = lang === 'id' ? 'en_US' : 'id_ID';
const personId = new URL('/#person', SITE_URL).toString();
const websiteId = new URL('/#website', SITE_URL).toString();
const profilePageId = `${canonicalUrl}#profile-page`;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': personId,
      name: PERSON_NAME,
      alternateName: [...PERSON_ALIASES],
      url: SITE_URL,
      image: AVATAR_URL,
      jobTitle: PERSON_ROLE,
      description,
      sameAs: [GITHUB_URL, LINKEDIN_URL],
      knowsAbout: [...PERSON_EXPERTISE],
      worksFor: {
        '@type': 'Organization',
        name: 'Monee',
      },
    },
    {
      '@type': 'WebSite',
      '@id': websiteId,
      url: SITE_URL,
      name: SEO_DEFAULTS.siteName,
      description: SEO_DEFAULTS.description,
      inLanguage: ['en', 'id'],
      publisher: { '@id': personId },
    },
    {
      '@type': 'ProfilePage',
      '@id': profilePageId,
      url: canonicalUrl,
      name: title,
      description,
      inLanguage: lang,
      isPartOf: { '@id': websiteId },
      about: { '@id': personId },
      mainEntity: { '@id': personId },
      primaryImageOfPage: {
        '@type': 'ImageObject',
        url: AVATAR_URL,
      },
    },
  ],
};
const structuredDataJson = JSON.stringify(structuredData).replaceAll('<', '\\u003c');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="author" content={SEO_DEFAULTS.author} />
    <meta name="theme-color" content={SEO_DEFAULTS.themeColor} />
    <link rel="canonical" href={canonicalUrl} />
    {
      alternateUrls.map(({ href, hreflang }) => (
        <link rel="alternate" hreflang={hreflang} href={href} />
      ))
    }
    <link rel="preconnect" href="https://avatars.githubusercontent.com" />

    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={SEO_DEFAULTS.openGraphType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={AVATAR_URL} />
    <meta property="og:site_name" content={SEO_DEFAULTS.siteName} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogAlternateLocale} />

    <meta name="twitter:card" content={SEO_DEFAULTS.twitterCard} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={AVATAR_URL} />

    <script is:inline type="application/ld+json" set:html={structuredDataJson} />

    <link rel="shortcut icon" href="/images/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/images/android-chrome-512x512.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/images/android-chrome-192x192.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16x16.png" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <script>
      import '../lib/disableDevtools';
    </script>
  </body>
</html>
